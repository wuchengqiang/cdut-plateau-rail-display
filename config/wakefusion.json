{
  "schemaVersion": "wakefusion.embedded-app/v1",
  "appId": "cdut-slider-screen",
  "version": "1.1.0",
  "actions": [
    {
      "id": "scene-p01",
      "enabled": true,
      "name": "高原启程",
      "description": "切换到高原启程展项，介绍科考队从成都出发。用户说启程、第一页或开始参观时使用",
      "keywords": ["启程", "第一页", "开始"],
      "negativeKeywords": [],
      "handler": "scene",
      "target": "p01"
    },
    {
      "id": "scene-p02",
      "enabled": true,
      "name": "地质巡测",
      "description": "切换到地质巡测展项。用户说地质、巡测或第二页时使用",
      "keywords": ["巡测", "地质", "第二页"],
      "negativeKeywords": [],
      "handler": "scene",
      "target": "p02"
    },
    {
      "id": "scene-p03",
      "enabled": true,
      "name": "冰川源区",
      "description": "切换到冰川源区展项。用户说冰川、源区或第三页时使用",
      "keywords": ["冰川", "源区", "第三页"],
      "negativeKeywords": [],
      "handler": "scene",
      "target": "p03"
    },
    {
      "id": "scene-p04",
      "enabled": true,
      "name": "高原守望",
      "description": "切换到高原守望展项。用户说守望、高原或第四页时使用",
      "keywords": ["守望", "高原", "第四页"],
      "negativeKeywords": [],
      "handler": "scene",
      "target": "p04"
    },
    {
      "id": "play",
      "enabled": true,
      "name": "播放",
      "description": "播放或继续播放当前展项视频。用户说播放、继续讲或接着放时使用",
      "keywords": ["播放", "继续", "继续讲解"],
      "negativeKeywords": ["停止播放", "停止巡展", "停止轮播"],
      "handler": "play"
    },
    {
      "id": "pause",
      "enabled": true,
      "name": "暂停",
      "description": "暂停当前展项视频，保留播放进度。仅在视频正在播放时使用，不用于停止自动巡展",
      "keywords": ["暂停", "等一下"],
      "negativeKeywords": ["停止播放", "停止视频", "停止巡展", "停止轮播", "回原点"],
      "handler": "pause"
    },
    {
      "id": "stop",
      "enabled": true,
      "name": "停止",
      "description": "停止当前展项视频并回到开头。仅用于停止视频，不用于停止自动巡展",
      "keywords": ["停止", "结束视频"],
      "negativeKeywords": ["停止巡展", "停止轮播", "回原点"],
      "handler": "stop"
    },
    {
      "id": "home",
      "enabled": true,
      "name": "返回首页",
      "description": "停止自动巡展和视频并返回机械原点。用户明确说首页、回原点或返回起点时使用",
      "keywords": ["首页", "回原点", "返回"],
      "negativeKeywords": ["上一页", "返回播放"],
      "handler": "home"
    },
    {
      "id": "carousel-start",
      "enabled": true,
      "name": "开始自动巡展",
      "description": "开始展项自动往返巡展。仅在当前未自动巡展时使用",
      "keywords": ["自动巡展", "自动播放", "开始轮播"],
      "negativeKeywords": ["停止巡展", "停止轮播"],
      "handler": "carousel_start"
    },
    {
      "id": "carousel-stop",
      "enabled": true,
      "name": "停止自动巡展",
      "description": "停止自动巡展并停在当前展项。仅在自动巡展进行中时使用，不用于暂停视频",
      "keywords": ["停止巡展", "停止轮播", "手动控制"],
      "negativeKeywords": ["暂停", "暂停视频", "停一下视频", "停止播放"],
      "handler": "carousel_stop"
    }
  ]
}
