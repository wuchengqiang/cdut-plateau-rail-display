# Frontend and Python build output
frontend/node_modules/
frontend/*.tsbuildinfo
backend/static/
build/
dist/
release/

# Local runtime data
logs/
tmp/
browser-profile/
config/admin.json
config/remote-control.key
__pycache__/
*.py[cod]

# Local editor and OS metadata
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Image-generation intermediates; only final transparent assets are versioned.
content/mascots/*-source.png

# Large现场媒体只由部署时复制，既不提交也不纳入通用绿色包。
content/videos/*.mp4
content/videos/*.webm
content/videos/*.mov
content/videos/*.m4v
content/videos/*.avi
content/videos/*.mkv
